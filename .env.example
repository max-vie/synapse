# Synapse local lab configuration
# Copy to .env and fill in real values; never commit .env files or tokens.
# Run: make lab-up to generate a starter .env with random secrets.

# -- Synapse API -------------------------------------------------------------
SYNAPSE_SERVICE_PORT=15515
SYNAPSE_ASK_WEBHOOK_URL=http://localhost:15515/webhook/synapse/ask
SYNAPSE_SECRET_DIR=secrets
SYNAPSE_CONTAINER_UID=1000
SYNAPSE_CONTAINER_GID=1000
SYNAPSE_WEBHOOK_AUTH_TOKEN_FILE=secrets/synapse_webhook_auth_token
SYNAPSE_AUTH_DISABLED=false    # default: off; set true only for no-network demo
SYNAPSE_MAX_REQUEST_BYTES=1048576
SYNAPSE_MAX_CONTENT_BYTES=262144
SYNAPSE_MAX_CHUNKS_PER_NOTE=32
SYNAPSE_MAX_QUESTION_LENGTH=1000
SYNAPSE_MAX_PARALLEL_EXECUTIONS=2
SYNAPSE_EMBED_BATCH_SIZE=16
SYNAPSE_HTTP_TIMEOUT_SECONDS=180
SYNAPSE_ANSWER_MODE=llm
SYNAPSE_ANSWER_VALIDATION=structural
RAG_QUOTE_OVERLAP_THRESHOLD=0.3

# -- Ollama ------------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_INTERNAL_BASE_URL=http://ollama:11434
OLLAMA_HOST_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_BASE_URL=
# Set true only for a signed-in Ollama Cloud relay. The overlay mounts these
# host key files read-only; model generation is remote, while embeddings remain
# local because Ollama Cloud does not currently publish embedding models.
OLLAMA_CLOUD_MODE=false
OLLAMA_CLOUD_KEY_FILE=/usr/share/ollama/.ollama/id_ed25519
OLLAMA_CLOUD_PUBLIC_KEY_FILE=/usr/share/ollama/.ollama/id_ed25519.pub
# Recommended quality model: qwen2.5-coder:14b. Change these two model tags together.
OLLAMA_FORMAT_MODEL=tinyllama:latest
OLLAMA_ANSWER_MODEL=tinyllama:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_FORMAT_NUM_PREDICT=768
OLLAMA_ANSWER_NUM_PREDICT=256

# -- Wiki.js -----------------------------------------------------------------
WIKIJS_PORT=3000
WIKIJS_PUBLIC_BASE_URL=
WIKIJS_LOCALE=en
WIKIJS_DB_NAME=wiki
WIKIJS_DB_USER=wikijs
WIKIJS_DB_PASSWORD_FILE=secrets/wikijs_db_password
# Write the token file after completing Wiki.js admin setup.
# See the Wiki.js setup steps in docs/SETUP.md.
WIKIJS_API_TOKEN_FILE=secrets/wikijs_api_token

# -- Qdrant ------------------------------------------------------------------
QDRANT_PORT=6333
QDRANT_COLLECTION_BASE=synapse_notes
QDRANT_COLLECTION=synapse_notes__nomic_embed_text__768
SYNAPSE_MANAGE_QDRANT_COLLECTION=true

# -- RAG behavior ------------------------------------------------------------
RAG_TOP_K=5
RAG_CANDIDATE_K=25
RAG_SCORE_THRESHOLD=0.35
RAG_QUERY_TERM_MIN_COVERAGE=0.6
RAG_QUERY_TERM_MIN_MATCHES=2
RAG_DOMAIN_GLOSSARY_JSON={}

# -- Obsidian/Markdown vault -------------------------------------------------
OBSIDIAN_VAULT_PATH=examples/obsidian-vault

# -- Docker image pins -------------------------------------------------------
# Image tags are defined as defaults in docker-compose.e2e.yml so this file
# does not need to pin them. To override, set QDRANT_IMAGE, OLLAMA_IMAGE,
# WIKIJS_IMAGE, WIKIJS_POSTGRES_IMAGE, or SYNAPSE_SERVICE_IMAGE here.
# Reviewed pins are listed in docs/VERSION_POLICY.md.
